# Apache / REG.RU. Public calculator URLs have no trailing slash.
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_HOST} ^www\.calccenter\.ru$ [NC]
RewriteRule ^ https://calccenter.ru%{REQUEST_URI} [R=301,L]

# Only redirect explicit browser requests, never internal rewrites.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# Flat prerender files: /credit.html -> /credit.
RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Route even existing legacy directories through PHP on Apache.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [END]

RedirectMatch 404 ^/dist\.zip$
