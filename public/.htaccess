# .htaccess — Apache (в т.ч. за nginx-прокси на хостинге).
# Каноническая форма URL — БЕЗ trailing slash (как в sitemap.xml и <link rel="canonical">).

# ── 1) www → non-www (301) ──────────────────────────────────
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_HOST} ^www\.calccenter\.ru$ [NC]
RewriteRule ^(.*)$ https://calccenter.ru/$1 [R=301,L]

# ── 2) Trailing slash → без слэша (301): /classic/ → /classic ──
# Условие по REQUEST_URI: правило срабатывает в контексте любого каталога,
# а не только корня. Корень (/) не матчится — нужен минимум 1 символ до слэша.
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# ── 3) /index.html → чистый URL (301) ───────────────────────
RewriteCond %{REQUEST_URI} ^/index\.html$
RewriteRule ^ / [R=301,L]

RewriteCond %{REQUEST_URI} ^/(.+)/index\.html$
RewriteRule ^ /%1 [R=301,L]

# ── 4) Clean URLs: /classic → index.php (отдаст prerendered /classic/index.html) ──
# Условие !-d намеренно убрано: иначе mod_dir сам перенаправит /classic → /classic/
# и канонический URL без слэша сломается.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /index.php [L]

# ── Служебный архив деплоя не отдаём ────────────────────────
RedirectMatch 404 ^/dist\.zip$
