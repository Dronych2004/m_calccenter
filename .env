# Calccenter — переменные окружения
# Используются через import.meta.env.VITE_* в коде

# Базовый URL сайта (для SEO, sitemap, canonical)
VITE_SITE_URL=https://calccenter.ru

# Курс евро по умолчанию (₽/€) — для калькулятора растаможки
VITE_EUR_RATE=100

# Ставка ЦБ РФ по умолчанию (%) — для калькулятора пеней
VITE_CBR_RATE=21
